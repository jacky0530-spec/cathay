{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'admin'))",
        ".write": false
      }
    },
    "users": {
      ".read": "auth != null && root.child('members').child(auth.uid).child('active').val() === true && root.child('members').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).child('active').val() === true",
        "lastLogin": {
          ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).child('active').val() === true",
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "device": {
          ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).child('active').val() === true",
          ".validate": "newData.isString() && newData.val().length <= 512"
        },
        "connections": {
          "$connectionId": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('members').child(auth.uid).child('active').val() === true)",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "clientBackups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).child('active').val() === true",
        ".indexOn": [
          "updatedAt"
        ],
        "$backupId": {
          ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).child('active').val() === true && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['schemaVersion','updatedAt','records']) && newData.child('schemaVersion').val() === 1 && newData.child('updatedAt').isString() && newData.child('updatedAt').val().length <= 40 && newData.child('records').hasChildren()"
        }
      }
    },
    "whitelist": {
      ".read": false,
      ".write": false
    }
  }
}
