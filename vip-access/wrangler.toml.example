# Firebase Realtime Database (NOT D1). Prepare in an isolated staging Worker.
# Source folder: vip-access/. Copy this template to local vip-access/wrangler.toml
# which is gitignored. NEVER paste private keys or secrets here.
name = "cathay-vip-firebase-staging"
main = "firebase-worker/index.mjs"
compatibility_date = "2026-11-17"
workers_dev = true

[vars]
FIREBASE_PROJECT_ID = "cathay-app-5889a"
SITE_ORIGIN = "https://jacky0530-spec.github.io"

# Secrets (set only in Cloudflare Worker encrypted Secrets):
#   FIREBASE_SERVICE_ACCOUNT_JSON  -- service account JSON key for cathay-app-5889a.
#   CODE_PEPPER                    -- independent 32+ random chars, never rotate casually
#   SESSION_SECRET                 -- independent 32+ random chars, not equal to CODE_PEPPER
# Optional ONLY for legacy built-in codes after explicit review:
#   LEGACY_COMPAT_CODES            -- comma-separated old codes, secret; rotate urgently
#
# No D1 database binding, ID, or extra database is required.
